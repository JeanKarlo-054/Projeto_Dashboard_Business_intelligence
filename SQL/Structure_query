Structure:
-- 1. TABELA DE CLIENTES
CREATE TABLE clientes_portfolio (
    id_cliente INT PRIMARY KEY,
    nome_cliente VARCHAR(100),
    estado_cliente VARCHAR(2), -- SP, RJ, MG, etc.
    data_cadastro DATE
);

-- 2. TABELA DE VENDAS DE PRODUTOS FÍSICOS
CREATE TABLE vendas_produtos (
    id_venda INT PRIMARY KEY,
    id_cliente INT,
    produto VARCHAR(100),
    categoria VARCHAR(50), -- 'Hardware', 'Periféricos', 'Mobile'
    valor_venda DECIMAL(10,2),
    data_pedido DATE,
    data_entrega DATE
);

-- 3. TABELA DE ASSINATURAS (SERVIÇOS DIGITAIS)
CREATE TABLE assinaturas_servicos (
    id_assinatura INT PRIMARY KEY,
    id_cliente INT,
    plano VARCHAR(50), -- 'Mensal', 'Anual'
    valor_mensal DECIMAL(10,2),
    data_inicio DATE,
    data_cancelamento DATE -- Se NULL, está ativo
);

